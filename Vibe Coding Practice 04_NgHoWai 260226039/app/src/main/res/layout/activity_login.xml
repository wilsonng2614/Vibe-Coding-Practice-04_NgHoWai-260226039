<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_mesh"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp">

            <TextView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:text="🎮"
                android:textSize="32sp"
                android:gravity="center"
                android:background="@drawable/bg_badge" />

            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Game Center"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1E1E2C"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tvLoginHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to continue (Default: admin / 1234)"
                android:textSize="13sp"
                android:textColor="#7C809B"
                android:layout_marginTop="4dp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="👤  Username"
                android:inputType="textPersonName"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="18dp"
                android:textSize="15sp"
                android:textColor="#1E1E2C"
                android:layout_marginTop="24dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="🔒  Password"
                android:inputType="textPassword"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="18dp"
                android:textSize="15sp"
                android:textColor="#1E1E2C"
                android:layout_marginTop="14dp" />

            <CheckBox
                android:id="@+id/cbRemember"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remember Me"
                android:textColor="#4A4E69"
                android:textSize="14sp"
                android:layout_marginTop="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="SIGN IN  ➔"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_gradient_primary"
                android:stateListAnimator="@null"
                android:layout_marginTop="18dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>